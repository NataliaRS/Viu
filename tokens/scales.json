    "4xl": { "$value": "{space/96}" }, "5xl": { "$value": "{space/128}" }, "6xl": { "$value": "{space/192}" },
    "stack-2xs": { "$value": "{space/4}" }, "stack-xs": { "$value": "{space/8}" }, "stack-sm": { "$value": "{space/12}" },
    "stack-md": { "$value": "{space/16}" }, "stack-lg": { "$value": "{space/24}" }, "stack-xl": { "$value": "{space/32}" },
    "inline-2xs": { "$value": "{space/4}" }, "inline-xs": { "$value": "{space/8}" }, "inline-sm": { "$value": "{space/12}" },
    "inline-md": { "$value": "{space/16}" }, "inline-lg": { "$value": "{space/24}" },
    "inset-xs": { "$value": "{space/8}" }, "inset-sm": { "$value": "{space/12}" }, "inset-md": { "$value": "{space/16}" }, "inset-lg": { "$value": "{space/24}" }
  },
  "radius": { "xs": { "$value": "{radius/xs}" }, "control": { "$value": "{radius/md}" }, "surface": { "$value": "{radius/lg}" }, "pill": { "$value": "{radius/round}" } },
  "border-width": { "default": { "$value": "{border-width/1}" }, "strong": { "$value": "{border-width/2}" }, "heavy": { "$value": "{border-width/4}" } },
  "z": {
    "hide": { "$value": "{z/hide}" }, "base": { "$value": "{z/base}" }, "raised": { "$value": "{z/raised}" }, "docked": { "$value": "{z/docked}" },
    "dropdown": { "$value": "{z/dropdown}" }, "sticky": { "$value": "{z/sticky}" }, "banner": { "$value": "{z/banner}" }, "overlay": { "$value": "{z/overlay}" },
    "modal": { "$value": "{z/modal}" }, "popover": { "$value": "{z/popover}" }, "toast": { "$value": "{z/toast}" }, "tooltip": { "$value": "{z/tooltip}" }
