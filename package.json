{
  "name": "@viu/design-tokens",
  "version": "0.1.0",
  "description": "VIU Design System — design tokens (primitives, semantic themes, scales). Single source of truth, 1:1 parity with Figma.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "ui"
  ],
  "main": "dist/tokens.js",
  "types": "dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./css": "./dist/tokens.css",
    "./json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build": "npm run build:tokens"
  }
