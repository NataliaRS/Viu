{
  "$description": "VIU Design System — Scale & foundation tokens. Spacing, radius, typography, breakpoints and grid. 1:1 parity with Figma 'Foundations · Specimens / Scales specimen'.",
  "space": {
    "3xs": { "$type": "dimension", "$value": "2px" },
    "2xs": { "$type": "dimension", "$value": "4px" },
    "xs":  { "$type": "dimension", "$value": "8px" },
    "sm":  { "$type": "dimension", "$value": "12px" },
    "md":  { "$type": "dimension", "$value": "16px" },
    "lg":  { "$type": "dimension", "$value": "24px" },
    "xl":  { "$type": "dimension", "$value": "32px" },
    "2xl": { "$type": "dimension", "$value": "48px" },
    "3xl": { "$type": "dimension", "$value": "64px" },
    "4xl": { "$type": "dimension", "$value": "96px" },
    "5xl": { "$type": "dimension", "$value": "128px" },
    "6xl": { "$type": "dimension", "$value": "192px" }
  },
  "radius": {
    "xs":      { "$type": "dimension", "$value": "4px" },
    "control": { "$type": "dimension", "$value": "8px" },
    "surface": { "$type": "dimension", "$value": "12px" },
    "pill":    { "$type": "dimension", "$value": "9999px" }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "\"PP Neue Montreal\", \"Inter\", system-ui, -apple-system, sans-serif" },
      "body":    { "$type": "fontFamily", "$value": "\"Google Sans\", \"Inter\", system-ui, -apple-system, sans-serif" },
      "label":   { "$type": "fontFamily", "$value": "\"General Sans\", \"Inter\", system-ui, -apple-system, sans-serif" },
      "code":    { "$type": "fontFamily", "$value": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium":  { "$type": "fontWeight", "$value": 500 }
    },
    "size": {
      "oversize-l": { "$type": "dimension", "$value": "82px" },
      "oversize-m": { "$type": "dimension", "$value": "73px" },
      "oversize-s": { "$type": "dimension", "$value": "65px" },
      "display-l":  { "$type": "dimension", "$value": "58px" },
      "display-m":  { "$type": "dimension", "$value": "51px" },
      "display-s":  { "$type": "dimension", "$value": "45px" },
      "headline-l": { "$type": "dimension", "$value": "40px" },
      "headline-m": { "$type": "dimension", "$value": "36px" },
      "headline-s": { "$type": "dimension", "$value": "32px" },
      "title-l":    { "$type": "dimension", "$value": "28px" },
      "title-m":    { "$type": "dimension", "$value": "25px" },
      "title-s":    { "$type": "dimension", "$value": "22px" },
      "body-xl":    { "$type": "dimension", "$value": "18px" },
      "body-l":     { "$type": "dimension", "$value": "16px" },
      "body-m":     { "$type": "dimension", "$value": "14px" },
      "body-s":     { "$type": "dimension", "$value": "12px" },
      "label-2xl":  { "$type": "dimension", "$value": "18px" },
      "label-xl":   { "$type": "dimension", "$value": "16px" },
      "label-l":    { "$type": "dimension", "$value": "14px" },
      "label-m":    { "$type": "dimension", "$value": "12px" },
      "label-s":    { "$type": "dimension", "$value": "11px" },
      "code-m":     { "$type": "dimension", "$value": "14px" },
      "code-s":     { "$type": "dimension", "$value": "12px" }
    }
  },
  "type": {
    "oversize-l": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.oversize-l}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.2", "letterSpacing": "-2px" } },
    "oversize-m": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.oversize-m}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.2", "letterSpacing": "-2px" } },
    "oversize-s": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.oversize-s}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.2", "letterSpacing": "-2px" } },
    "display-l":  { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.display-l}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.2", "letterSpacing": "-2px" } },
    "display-m":  { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.display-m}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.2", "letterSpacing": "-2px" } },
    "display-s":  { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.display-s}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.2", "letterSpacing": "-2px" } },
    "headline-l": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.headline-l}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.2", "letterSpacing": "-2px" } },
    "headline-m": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.headline-m}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.2", "letterSpacing": "-2px" } },
    "headline-s": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.headline-s}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.2", "letterSpacing": "-2px" } },
    "title-l":    { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.title-l}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.3", "letterSpacing": "0" } },
    "title-m":    { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.title-m}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.3", "letterSpacing": "0" } },
    "title-s":    { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.title-s}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.3", "letterSpacing": "0" } },
    "body-xl":    { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.body-xl}", "fontWeight": "{font.weight.regular}", "lineHeight": "1.5", "letterSpacing": "0" } },
    "body-l":     { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.body-l}", "fontWeight": "{font.weight.regular}", "lineHeight": "1.5", "letterSpacing": "0" } },
    "body-m":     { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.body-m}", "fontWeight": "{font.weight.regular}", "lineHeight": "1.5", "letterSpacing": "0" } },
    "body-s":     { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.body-s}", "fontWeight": "{font.weight.regular}", "lineHeight": "1.5", "letterSpacing": "0" } },
    "label-2xl":  { "$type": "typography", "$value": { "fontFamily": "{font.family.label}", "fontSize": "{font.size.label-2xl}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.5", "letterSpacing": "0" } },
    "label-xl":   { "$type": "typography", "$value": { "fontFamily": "{font.family.label}", "fontSize": "{font.size.label-xl}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.5", "letterSpacing": "0" } },
    "label-l":    { "$type": "typography", "$value": { "fontFamily": "{font.family.label}", "fontSize": "{font.size.label-l}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.5", "letterSpacing": "0" } },
    "label-m":    { "$type": "typography", "$value": { "fontFamily": "{font.family.label}", "fontSize": "{font.size.label-m}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.5", "letterSpacing": "0" } },
    "label-s":    { "$type": "typography", "$value": { "fontFamily": "{font.family.label}", "fontSize": "{font.size.label-s}", "fontWeight": "{font.weight.medium}", "lineHeight": "1.5", "letterSpacing": "4px" } },
    "code-m":     { "$type": "typography", "$value": { "fontFamily": "{font.family.code}", "fontSize": "{font.size.code-m}", "fontWeight": "{font.weight.regular}", "lineHeight": "1.5", "letterSpacing": "0" } },
    "code-s":     { "$type": "typography", "$value": { "fontFamily": "{font.family.code}", "fontSize": "{font.size.code-s}", "fontWeight": "{font.weight.regular}", "lineHeight": "1.5", "letterSpacing": "0" } }
  },
  "breakpoint": {
    "base": { "$type": "dimension", "$value": "375px" },
    "sm":   { "$type": "dimension", "$value": "768px" },
    "md":   { "$type": "dimension", "$value": "1024px" },
    "lg":   { "$type": "dimension", "$value": "1280px" },
    "xl":   { "$type": "dimension", "$value": "1440px" },
    "2xl":  { "$type": "dimension", "$value": "1920px" }
  },
  "grid": {
    "base": { "columns": 4,  "gutter": "16px", "margin": "16px" },
    "sm":   { "columns": 8,  "gutter": "24px", "margin": "32px" },
    "md":   { "columns": 8,  "gutter": "24px", "margin": "48px" },
    "lg":   { "columns": 12, "gutter": "32px", "margin": "48px" },
    "xl":   { "columns": 12, "gutter": "32px", "margin": "64px" },
    "2xl":  { "columns": 12, "gutter": "32px", "margin": "96px" }
  }
}
