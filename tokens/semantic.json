{
  "$description": "VIU Design System — Semantic color tokens. The ONLY color layer components may consume (never primitives, never raw hex). Each token aliases a primitive per theme. Black-first: 'dark' is the default theme (:root). 1:1 parity with Figma 'Semantic · Color · Dark / Light'.",
  "color": {
    "bg": {
      "base":          { "$type": "color", "dark": "{color.neutral.900}", "light": "{color.neutral.0}" },
      "raised":        { "$type": "color", "dark": "{color.neutral.800}", "light": "{color.neutral.25}" },
      "elevated":      { "$type": "color", "dark": "{color.neutral.700}", "light": "{color.neutral.50}" },
      "sunken":        { "$type": "color", "dark": "{color.neutral.950}", "light": "{color.neutral.100}" },
      "strong":        { "$type": "color", "dark": "{color.neutral.650}", "light": "{color.neutral.200}" },
      "subtle":        { "$type": "color", "dark": "{alpha.white-06}",    "light": "{color.neutral.75}" },
      "hover":         { "$type": "color", "dark": "{alpha.white-06}",    "light": "{alpha.black-08}" },
      "pressed":       { "$type": "color", "dark": "{alpha.white-12}",    "light": "{alpha.black-14}" },
      "overlay":       { "$type": "color", "dark": "{alpha.black-72}",    "light": "{alpha.black-72}" },
      "disabled":      { "$type": "color", "dark": "{color.neutral.850}", "light": "{color.neutral.75}" },
      "brand":         { "$type": "color", "dark": "{color.red.500}",     "light": "{color.red.500}" },
      "brand-hover":   { "$type": "color", "dark": "{color.red.400}",     "light": "{color.red.400}" },
      "brand-pressed": { "$type": "color", "dark": "{color.red.600}",     "light": "{color.red.600}" },
      "brand-subtle":  { "$type": "color", "dark": "{alpha.red-12}",      "light": "{alpha.red-12}" },
      "brand-2":         { "$type": "color", "dark": "{color.indigo.500}", "light": "{color.indigo.900}" },
      "brand-2-subtle":  { "$type": "color", "dark": "{alpha.indigo-14}",  "light": "{alpha.indigo-14}" }
    },
    "text": {
      "primary":     { "$type": "color", "dark": "{color.neutral.50}",  "light": "{color.neutral.900}" },
      "secondary":   { "$type": "color", "dark": "{color.neutral.300}", "light": "{color.neutral.600}" },
      "tertiary":    { "$type": "color", "dark": "{color.neutral.400}", "light": "{color.neutral.500}" },
      "muted":       { "$type": "color", "dark": "{color.neutral.500}", "light": "{color.neutral.400}" },
      "disabled":    { "$type": "color", "dark": "{color.neutral.600}", "light": "{color.neutral.300}" },
      "on-brand":    { "$type": "color", "dark": "{color.neutral.0}",   "light": "{color.neutral.0}" },
      "brand":       { "$type": "color", "dark": "{color.red.300}",     "light": "{color.red.700}" },
      "brand-2":     { "$type": "color", "dark": "{color.indigo.300}",  "light": "{color.indigo.900}" },
      "on-brand-2":  { "$type": "color", "dark": "{color.neutral.0}",   "light": "{color.neutral.0}" },
      "link":        { "$type": "color", "dark": "{color.indigo.300}",  "light": "{color.indigo.900}" },
      "link-hover":  { "$type": "color", "dark": "{color.indigo.400}",  "light": "{color.indigo.700}" }
    },
    "border": {
      "subtle":   { "$type": "color", "dark": "{alpha.white-16}", "light": "{alpha.black-08}" },
      "default":  { "$type": "color", "dark": "{alpha.white-28}", "light": "{alpha.black-14}" },
      "strong":   { "$type": "color", "dark": "{alpha.white-40}", "light": "{alpha.black-24}" },
      "focus":    { "$type": "color", "dark": "{color.indigo.500}", "light": "{color.indigo.700}" },
      "brand-2":  { "$type": "color", "dark": "{color.indigo.500}", "light": "{color.indigo.700}" }
    },
    "feedback": {
      "success-text":     { "$type": "color", "dark": "{color.green.400}", "light": "{color.green.700}" },
      "success-border":   { "$type": "color", "dark": "{color.green.500}", "light": "{color.green.600}" },
      "success-surface":  { "$type": "color", "dark": "{alpha.green-14}",  "light": "{color.green.50}" },
      "success-solid":    { "$type": "color", "dark": "{color.green.500}", "light": "{color.green.600}" },
      "success-on-solid": { "$type": "color", "dark": "{color.neutral.950}", "light": "{color.neutral.0}" },
      "warning-text":     { "$type": "color", "dark": "{color.amber.400}", "light": "{color.amber.700}" },
      "warning-border":   { "$type": "color", "dark": "{color.amber.500}", "light": "{color.amber.600}" },
      "warning-surface":  { "$type": "color", "dark": "{alpha.amber-16}",  "light": "{color.amber.50}" },
      "warning-solid":    { "$type": "color", "dark": "{color.amber.400}", "light": "{color.amber.500}" },
      "warning-on-solid": { "$type": "color", "dark": "{color.neutral.950}", "light": "{color.neutral.950}" },
      "danger-text":      { "$type": "color", "dark": "{color.alert.400}", "light": "{color.alert.600}" },
      "danger-border":    { "$type": "color", "dark": "{color.alert.500}", "light": "{color.alert.500}" },
      "danger-surface":   { "$type": "color", "dark": "{alpha.alert-14}",  "light": "{color.alert.50}" },
      "danger-solid":     { "$type": "color", "dark": "{color.alert.600}", "light": "{color.alert.600}" },
      "danger-on-solid":  { "$type": "color", "dark": "{color.neutral.0}", "light": "{color.neutral.0}" },
      "info-text":        { "$type": "color", "dark": "{color.blue.400}",  "light": "{color.blue.700}" },
      "info-border":      { "$type": "color", "dark": "{color.blue.500}",  "light": "{color.blue.600}" },
      "info-surface":     { "$type": "color", "dark": "{alpha.blue-14}",   "light": "{color.blue.50}" },
      "info-solid":       { "$type": "color", "dark": "{color.blue.600}",  "light": "{color.blue.600}" },
      "info-on-solid":    { "$type": "color", "dark": "{color.neutral.0}", "light": "{color.neutral.0}" }
    }
  }
}
